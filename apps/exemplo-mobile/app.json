{
    "expo": {
        "name": "MakaChat Exemplo",
        "slug": "makachat-exemplo",
        "version": "1.0.0",
        "orientation": "portrait",
        "scheme": "makachat-exemplo",
        "userInterfaceStyle": "light",
        "newArchEnabled": true,
        "ios": {
            "bundleIdentifier": "com.hongayetu.makachat.exemplo",
            "infoPlist": {
                "NSCameraUsageDescription": "Chamadas de vídeo e envio de fotos",
                "NSMicrophoneUsageDescription": "Chamadas de voz e mensagens de áudio",
                "NSPhotoLibraryUsageDescription": "Envio de fotos e vídeos"
            }
        },
        "android": {
            "package": "com.hongayetu.makachat.exemplo",
            "permissions": [
                "CAMERA",
                "RECORD_AUDIO",
                "MODIFY_AUDIO_SETTINGS",
                "FOREGROUND_SERVICE",
                "FOREGROUND_SERVICE_MICROPHONE",
                "FOREGROUND_SERVICE_MEDIA_PROJECTION",
                "POST_NOTIFICATIONS",
                "USE_FULL_SCREEN_INTENT"
            ]
        },
        "plugins": [
            "expo-sqlite",
            "expo-audio",
            "expo-video",
            "expo-image-picker",
            "@livekit/react-native-expo-plugin",
            ["react-native-notify-kit", { "android": { "foregroundService": { "types": ["microphone", "mediaProjection"] } } }]
        ]
    }
}
