{
    "name": "@hongayetu/makachat-react",
    "version": "0.1.0",
    "description": "MakaChat para React web: provider e hooks (sem storage persistente — a fonte é o servidor)",
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git@github.com:HongaYetu/makachat-js.git",
        "directory": "packages/react"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./styles.css": "./dist/styles.css"
    },
    "files": [
        "dist",
        "sons"
    ],
    "scripts": {
        "build": "tsup && tailwindcss -c tailwind.config.js -i src/styles.css -o dist/styles.css --minify && cp -R sons dist/sons",
        "test": "echo 'sem testes próprios (lógica no core)'"
    },
    "dependencies": {
        "@hongayetu/makachat-core": "workspace:*",
        "@iconify/react": "^6.0.2"
    },
    "peerDependencies": {
        "livekit-client": ">=2.0.0",
        "react": ">=18.0.0"
    },
    "devDependencies": {
        "@types/react": "^18.3.0",
        "livekit-client": "^2.20.0",
        "tailwindcss": "^3.4.19",
        "tsup": "^8.3.0",
        "typescript": "^5.7.0"
    }
}
