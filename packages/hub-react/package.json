{
    "name": "@hongayetu/honga-hub-react",
    "version": "0.1.0",
    "description": "Provider global do Honga Hub para React web: ligação socket, token e canais de eventos (sem chat)",
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git@github.com:HongaYetu/honga-hub-js.git",
        "directory": "packages/hub-react"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "main": "./dist/index.cjs",
